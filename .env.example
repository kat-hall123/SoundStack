# Copy this file to .env and fill in the real values.
# Do NOT commit .env. Do NOT put real secrets in this file.

# MongoDB Atlas connection string.
# Create a new DB user for this project (see assignment instructions).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soundstack?retryWrites=true&w=majority

# Spotify Web API credentials.
# Create a free app at https://developer.spotify.com/dashboard
# and paste the Client ID and Client Secret below.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Local port (Render sets this automatically in production).
PORT=3000
